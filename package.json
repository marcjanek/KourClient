{
    "name": "kour-client",
    "productName": "Kour.io Client",
    "version": "2.0.0",
    "description": "Improved desktop client for Kour.io (fork of the official Kour-io/KourClient)",
    "main": "dist/main/main.js",
    "keywords": [
        "kour.io",
        "client",
        "electron"
    ],
    "author": "marcjanek",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "build": "tsc -p .",
        "watch": "tsc -p . --watch",
        "start": "npm run build && electron .",
        "typecheck": "tsc -p . --noEmit",
        "dist": "npm run build && electron-builder"
    },
    "dependencies": {
        "discord-rpc-revamp": "^2.0.4",
        "electron-updater": "^6.8.11"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "electron": "^45.2.1",
        "electron-builder": "^26.18.0",
        "typescript": "^5.9.0"
    }
}
