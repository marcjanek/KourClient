{
	"$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
	"appId": "io.kour.client.marcjanek",
	"productName": "Kour.io Client",
	"icon": "assets/icon.png",
	"directories": { "output": "release" },
	"files": ["dist/**/*", "!dist/**/*.map", "static/**/*", "assets/**/*", "betas.json", "package.json"],
	"artifactName": "${name}-${os}-${version}-${arch}.${ext}",
	"win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
	"nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
	"mac": { "category": "public.app-category.games", "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }] },
	"linux": { "category": "Game", "target": ["AppImage", "deb"] },
	"publish": { "provider": "github", "owner": "marcjanek", "repo": "KourClient", "releaseType": "draft" }
}
